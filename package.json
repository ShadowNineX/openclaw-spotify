{
  "name": "@shadowninex/openclaw-spotify",
  "version": "0.1.10",
  "description": "Spotify integration plugin for OpenClaw",
  "type": "module",
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json",
    "README.md",
    "changelog.md"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build ./index.ts --outdir ./dist --target bun --format esm --external openclaw --external typebox --external @shadownine/foxify --external sharp",
    "check": "tsc --noEmit",
    "plugin:build": "bun run build && openclaw plugins build --root . --entry ./dist/index.js",
    "plugin:validate": "bun run build && openclaw plugins validate --root . --entry ./dist/index.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "openclaw": "2026.10.9",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.11",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "clawhubSpec": "shadowninex/openclaw-spotify",
      "defaultChoice": "clawhub"
    },
    "compat": {
      "pluginApi": ">=2026.6.11",
      "minGatewayVersion": "2026.6.11"
    },
    "build": {
      "openclawVersion": "2026.10.9",
      "pluginSdkVersion": "2026.10.9"
    }
  },
  "dependencies": {
    "@shadownine/foxify": "^0.1.5",
    "sharp": "^0.35.5",
    "typebox": "1.4.3"
  }
}
